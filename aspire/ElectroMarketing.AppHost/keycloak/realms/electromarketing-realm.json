{
  "realm": "electromarketing",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Can read container data"
      },
      {
        "name": "platform-admin",
        "description": "Platform administrator"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-electromarketing",
    "composite": true,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization",
        "user"
      ]
    }
  },
  "clients": [
    {
      "clientId": "web",
      "name": "ElectroMarketing web",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${WEB_BASE_URL}/*"
      ],
      "webOrigins": [
        "${WEB_BASE_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${WEB_BASE_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "api",
      "name": "ElectroMarketing api",
      "enabled": true,
      "bearerOnly": true
    }
  ]
}
